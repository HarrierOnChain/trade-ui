# Market-data API: the host root (the API serves its routes there).
#   https://api.raze.bot       public API
#   http://localhost:8810      a local API (its default PORT)
RAZE_API_BASE=https://api.raze.bot
# Sent as x-api-key by the server-side proxies (/api/raze/* and, under
# `npm start`, the /api/ws WebSocket); never handed to the browser. Leave it
# empty for an API running without keys.
RAZE_API_KEY=

# Solana swaps. The router quotes and builds (keyless); the RPC sends,
# confirms and reads balances, and must accept v1 transactions (SIMD-0385).
RAZE_ROUTER_BASE=https://router.raze.bot
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: the RPC's WebSocket (default: SOLANA_RPC_URL with ws/wss).
# SOLANA_WS_URL=
# Optional: cap of the router's priority-fee estimate, lamports (default 500000).
# SWAP_PRIORITY_MAX_LAMPORTS=500000
