# Trade UI configuration. Copy to `.env` and fill in RAZE_API_KEY.
# Everything here is read by the server only: none of it reaches the browser.

# ── Raze ────────────────────────────────────────────────────────────────
# Your API key (raze.bot → API keys). Used for market data and for the swap
# router, as x-api-key, by the server.
RAZE_API_KEY=
# The market-data API. A local API: http://localhost:8810
RAZE_API_BASE=https://api.raze.bot
# The Solana router: quotes and swap builds.
RAZE_ROUTER_BASE=https://router.raze.bot
# The EVM router (Ethereum, BNB Chain, Base, Robinhood): quotes and swap builds.
RAZE_ROUTER_EVM_BASE=https://router.raze.bot/evm

# ── Solana ──────────────────────────────────────────────────────────────
# Sends and confirms swaps and transfers, reads balances. It must accept v1
# transactions (SIMD-0385). The public endpoint is rate-limited: use your own
# for real volume. A key in the URL stays on the server.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Its WebSocket, for confirmations. Default: SOLANA_RPC_URL with ws(s)://
# SOLANA_WS_URL=
# Cap of the router's own priority-fee estimate when you set none, lamports.
# SWAP_PRIORITY_MAX_LAMPORTS=500000
# 1 lets a quote split across two routes.
# SWAP_ALLOW_SPLIT=0
# The most slippage a quote may ask for, in basis points (5000 = 50 %). Quotes
# are kept by the server and trades are built from them as the router gave
# them, so this is the worst a trade can be asked to accept.
# SWAP_MAX_SLIPPAGE_BPS=5000

# ── EVM chains ──────────────────────────────────────────────────────────
# One RPC per chain: sends swaps, reads balances and receipts (it must answer
# eth_getTransactionReceipt). Defaults: free public endpoints (README →
# Configuration). Use your own for real volume.
# EVM_RPC_URL_ETH=
# EVM_RPC_URL_BSC=
# EVM_RPC_URL_BASE=
# EVM_RPC_URL_ROBINHOOD=
# Their WebSockets, for new blocks. Default: your RPC's with ws(s)://, or
# publicnode's when you set no RPC.
# EVM_WS_URL_ETH=

# ── Server ──────────────────────────────────────────────────────────────
# Where to listen. Default 127.0.0.1: keep it unless something else must
# reach it directly; on a VPS put it behind HTTPS (README → Host it on a
# server). Docker and the systemd unit set it themselves.
# HOST=127.0.0.1
# PORT=3000
# Where the encrypted vault (vault.json) is kept. Back this folder up.
# Default ./data; Docker and the systemd unit set it themselves.
# TRADE_UI_DATA_DIR=./data
# The address you open Trade UI at, when it is not localhost or an IP: a
# domain, usually behind a reverse proxy. Requests naming any other host are
# refused (that stops DNS rebinding), so a domain needs this line.
# TRADE_UI_PUBLIC_URL=https://trade.example.com
# More host names to answer for, comma-separated (e.g. a LAN name: box.lan:3000).
# TRADE_UI_ALLOWED_HOSTS=
# Fix the first-run setup code instead of a random one (automation).
# TRADE_UI_SETUP_TOKEN=
