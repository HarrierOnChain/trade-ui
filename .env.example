# Market-data API: the host root, without /v1 (the proxy adds it).
#   https://api.raze.bot       public API
#   http://localhost:8810      a local API (its default PORT)
RAZE_API_BASE=https://api.raze.bot
# Sent as x-api-key by the server-side proxies (/api/raze/* and, under
# `npm start`, the /api/ws WebSocket); never handed to the browser. Leave it
# empty for an API running without keys.
RAZE_API_KEY=
